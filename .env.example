# wabot-sketch env (placeholders only; values live in Railway).

# Meta WhatsApp Cloud API
META_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# pp-sketch (Railway private network). PP_INTERNAL_API_KEY is wabot's badge
# for pp's /wabot/inbound — the same value as pp-sketch's
# WABOT_INBOUND_API_KEY; sendMessage fails closed without it.
PP_INTERNAL_BASE_URL=http://pp-sketch.railway.internal:3000
PP_INTERNAL_API_KEY=

# What pp-sketch must present on wabot's /sendMessage etc. (x-api-key).
INTERNAL_API_KEY=

FALL_BACK_MESSAGE_PUBLIC_URL=

# OpenTelemetry → pp-infra Alloy collector
OTEL_SERVICE_NAME=wabot-sketch
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
OTEL_LOGS_EXPORTER=
OTEL_RESOURCE_ATTRIBUTES=
